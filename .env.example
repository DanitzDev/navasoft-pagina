# Simulación del formulario de contacto solo en desarrollo.
CONTACT_DELIVERY_MODE=disabled

# Configuración privada del servidor para ORDS; nunca usar prefijo VITE_.
ORDS_BASE_URL=
ORDS_CLIENT_ID=
ORDS_CLIENT_SECRET=

# Cambiar a true solo si el proxy de confianza sobrescribe X-Forwarded-For.
ORDS_TRUST_X_FORWARDED_FOR=false
